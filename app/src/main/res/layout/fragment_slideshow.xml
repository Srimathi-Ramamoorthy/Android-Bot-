    <!-- 🔵 WELCOME SECTION -->

    <ImageView
        android:id="@+id/logo_image1"
        android:layout_width="385dp"
        android:layout_height="130dp"
        android:layout_marginTop="30dp"
        android:contentDescription="CRI Logo"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:id="@+id/welcomeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/titleWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to CRI PUMPS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/titleInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose dashboard for Bot Assistant"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 🔵 MODULE BUTTON AREA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewModules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"
        android:contentDescription="Module selection list"
        android:textColor="#000000"
        android:importantForAccessibility="yes"
        android:focusable="true"
        android:focusableInTouchMode="true" />

